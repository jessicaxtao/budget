# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Settings -> API page. Create React App only exposes variables prefixed
# REACT_APP_, and it inlines them into the bundle at build time.
#
# The anon key is *meant* to be public — it identifies the project, not the
# user, and every row it can reach is gated by row-level security. Never put the
# service_role key here: it bypasses RLS entirely and this is a browser bundle.
#
# With these unset the app still runs, signed out, against this browser's own
# localStorage — which is how the test suite runs it.

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
